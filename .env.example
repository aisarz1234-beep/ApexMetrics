# ApexMetrics Production Environment Variables
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5000

# Authentication & Security Secrets
JWT_SECRET=apexmetrics_super_secure_jwt_secret_key_2026_production
BCRYPT_SALT_ROUNDS=10

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://apexuser:apexpassword@localhost:5432/apexmetrics

# Redis Sorted Set Configuration
REDIS_URL=redis://localhost:6379

# Strava API Integration (Optional OAuth 2.0 Credentials)
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=http://localhost:5000/api/auth/strava/callback
